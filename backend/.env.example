# Copy to backend/.env and fill in. Never commit backend/.env.

# Required. Signs email verification tokens; the backend will not start if this is missing or empty.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Email (local default: console prints messages instead of sending)
MAIL_BACKEND=console
# For Gmail SMTP, set MAIL_BACKEND=smtp and use a Google App Password (not your normal password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# From address used in outgoing mail
MAIL_SENDER=
# Base URL for verification links (e.g. /verify?token=...)
FRONTEND_URL=http://localhost:3000
