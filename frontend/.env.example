# Copy values into .env.development / .env.production as needed.
# Never commit real secrets. The Google Client Secret must NOT go in the frontend.

# Optional. Backend API origin used by the React app.
REACT_APP_API_BASE=http://127.0.0.1:5000

# Google Identity Services Web Client ID (OAuth 2.0 client ID only).
# Must match the backend GOOGLE_CLIENT_ID used to verify ID tokens.
REACT_APP_GOOGLE_CLIENT_ID=
